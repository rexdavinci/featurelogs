# Runtime configuration is read once by .env.ts. Restart after changing values.
# Local default: deterministic offline drafts. Select a real provider to enable AI.
AI_PROVIDER=mock
# openrouter | openai | gemini | mock
AI_MODEL=
# Leave blank to use the selected provider's default model.
OPENROUTER_API_KEY=
OPENAI_API_KEY=
GEMINI_API_KEY=

# Storage: neon | firestore. Auth: neon | firebase.
# Neon password auth requires DATABASE_URL even if storage uses Firestore.
DB_PROVIDER=neon
AUTH_PROVIDER=neon
DATABASE_URL=

# Password reset email. Resend is the implemented default provider.
EMAIL_PROVIDER=resend
# Other selections fail explicitly until their adapters are implemented.
RESEND_API_KEY=
# Use a sender on a domain verified in your Resend account.
EMAIL_FROM=

# Required only when using Firestore or Firebase token verification.
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
# Quoted private key; escaped \n characters are supported.
FIREBASE_SERVICE_KEY=

# Optional shared rate limiter; existing behavior bypasses it if unconfigured.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

SITE_URL=http://localhost:3000
GOOGLE_SITE_VERIFICATION=
